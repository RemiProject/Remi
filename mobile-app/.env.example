# Optional base URL override; no /graphql suffix. Public configuration only.
# Without this, development uses the Expo LAN host on port 3000 (web: browser host).
# Android emulator override: http://10.0.2.2:3000
# Physical phone override: http://<Windows-LAN-IP>:3000
# Production requires an explicit reachable HTTPS backend URL.
# EXPO_PUBLIC_API_URL=http://192.168.1.10:3000
