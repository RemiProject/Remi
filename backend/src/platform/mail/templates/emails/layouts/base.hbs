<!doctype html>
<html lang="{{lang}}" dir="{{dir}}">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{subject}}</title></head>
<body style="margin:0;background:#f4f6f8;font-family:Tahoma,Arial,sans-serif;color:#1f2937">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr><td align="center" style="padding:24px">
    <table role="presentation" width="560" cellpadding="0" cellspacing="0" style="background:#ffffff;border-radius:12px;padding:32px;max-width:560px">
      <tr><td style="font-size:20px;font-weight:700;padding-bottom:16px">AI Kitchen</td></tr>
      <tr><td style="font-size:15px;line-height:1.8">{{{body}}}</td></tr>
      {{#if footer}}<tr><td style="font-size:12px;color:#6b7280;padding-top:24px">{{footer}}</td></tr>{{/if}}
    </table>
  </td></tr></table>
</body>
</html>
