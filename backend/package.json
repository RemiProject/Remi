{
  "name": "ai-kitchen-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "prisma generate && nest build && tsc-alias -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "start:dev": "tsc-watch -p tsconfig.build.json --onSuccess \"node scripts/dev-on-success.mjs\"",    "seed": "tsx --env-file-if-exists=.env prisma/seed/reference.seed.ts",
    "seed:catalog": "tsx --env-file-if-exists=.env prisma/seed/catalog.seed.ts",
    "db:pull": "prisma db pull",
    "db:generate": "prisma generate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --configLoader native",
    "test:integration:phase5": "pnpm run build && node --env-file-if-exists=.env scripts/verify-phase5.mjs",
    "test:integration:phase6": "pnpm run build && node --env-file-if-exists=.env scripts/verify-phase6.mjs",
    "test:integration:phase7": "pnpm run build && node --env-file-if-exists=.env scripts/verify-phase7.mjs",
    "test:integration:phase10": "node --env-file-if-exists=.env scripts/verify-phase10.mjs",
    "phase11:rls-audit": "node --env-file-if-exists=.env scripts/audit-phase11.mjs",
    "phase11:backup-restore": "node --env-file-if-exists=.env scripts/phase11-backup-restore.mjs",
    "phase11:query-baseline": "node --env-file-if-exists=.env scripts/phase11-query-baseline.mjs",
    "phase11:load": "node --env-file-if-exists=.env scripts/load-phase11.mjs",
    "seed:safety": "node --env-file-if-exists=.env scripts/seed-safety.mjs",
    "data:import": "node --env-file-if-exists=.env scripts/import-catalog-data.mjs",
    "data:check": "node --env-file-if-exists=.env scripts/import-catalog-data.mjs --dry-run",
    "embeddings:local": ".venv\\Scripts\\python.exe scripts/local_embeddings.py",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:watch": "vitest --configLoader native",
    "db:validate": "prisma validate",
    "db:format": "prisma format",
    "db:studio": "prisma studio",
    "db:psql": "docker compose --profile app exec db sh -c 'psql -U \"$POSTGRES_USER\" -d \"$POSTGRES_DB\"'",
    "db:reset": "docker compose --profile app exec -T db sh -c 'psql -U \"$POSTGRES_USER\" -d \"$POSTGRES_DB\" -c \"DROP SCHEMA public CASCADE; CREATE SCHEMA public;\"' && pnpm migrate && pnpm seed",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "db:search:index": "node --env-file-if-exists=.env scripts/build-search-index.mjs",
    "docker:infra": "docker compose --profile app up -d db s3 mailpit",
    "docker:up": "docker compose --profile app up -d --build",
    "docker:down": "docker compose --profile app down",
    "docker:stop": "docker compose --profile app stop",
    "docker:start": "docker compose --profile app start",
    "docker:restart": "docker compose --profile app restart",
    "docker:ps": "docker compose --profile app ps",
    "docker:logs": "docker compose --profile app logs -f --tail=100",
    "docker:build": "docker compose --profile app build api",
    "docker:clean": "docker compose --profile app down -v --remove-orphans",
    "docker:db:up": "docker compose --profile app up -d db",
    "docker:db:stop": "docker compose --profile app stop db",
    "docker:db:restart": "docker compose --profile app restart db",
    "docker:db:logs": "docker compose --profile app logs -f --tail=100 db",
    "docker:db:rm": "docker compose --profile app rm -sf db",
    "docker:s3:up": "docker compose --profile app up -d s3",
    "docker:s3:stop": "docker compose --profile app stop s3",
    "docker:s3:restart": "docker compose --profile app restart s3",
    "docker:s3:logs": "docker compose --profile app logs -f --tail=100 s3",
    "docker:s3:rm": "docker compose --profile app rm -sf s3",
    "docker:mailpit:up": "docker compose --profile app up -d mailpit",
    "docker:mailpit:stop": "docker compose --profile app stop mailpit",
    "docker:mailpit:restart": "docker compose --profile app restart mailpit",
    "docker:mailpit:logs": "docker compose --profile app logs -f --tail=100 mailpit",
    "docker:mailpit:rm": "docker compose --profile app rm -sf mailpit",
    "docker:api:up": "docker compose --profile app up -d --build api",
    "docker:api:stop": "docker compose --profile app stop api",
    "docker:api:restart": "docker compose --profile app restart api",
    "docker:api:logs": "docker compose --profile app logs -f --tail=100 api",
    "docker:api:rm": "docker compose --profile app rm -sf api",
    "docker:migrate": "docker compose --profile app run --rm migrate"
  },
  "dependencies": {
    "@apollo/server": "^5.0.0",
    "@as-integrations/express5": "^1.1.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@nestjs/apollo": "^14.0.0",
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/cqrs": "^12.1.0",
    "@nestjs/graphql": "^14.0.0",
    "@nestjs/jwt": "^12.0.0",
    "@nestjs/platform-express": "^12.0.0",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "argon2": "^0.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "graphql": "^16.11.0",
    "handlebars": "^4.7.8",
    "helmet": "^8.0.0",
    "luxon": "^3.6.0",
    "nestjs-pino": "^5.0.0",
    "nodemailer": "^7.0.0",
    "pg": "^8.13.0",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^11.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/testing": "^12.0.0",
    "@types/express": "^5.0.0",
    "@types/luxon": "^3.6.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.0",
    "eslint": "^10.12.0",
    "fast-check": "^3.23.2",
    "globals": "^17.13.0",
    "prisma": "^7.10.0",
    "tsc-alias": "^1.9.7",
    "tsc-watch": "^7.2.1",
    "tsx": "^4.19.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.71.2",
    "vitest": "^3.2.0"
  }
}
