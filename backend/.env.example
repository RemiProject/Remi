# ───────── runtime ─────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
APP_BASE_URL=http://localhost:3000
WEB_BASE_URL=http://localhost:5173            # used inside email links
CORS_ORIGINS=http://localhost:5173

# ───────── database ─────────
# DATABASE_URL is the API runtime account. In production it must be non-superuser and must not have BYPASSRLS.
# Keep DATABASE_URL_MIGRATOR separate and use it only for schema migrations and trusted seed jobs.
POSTGRES_USER=kitchen
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_DB=ai_kitchen
DB_PORT=5432
DATABASE_URL=postgresql://kitchen:change-me-dev-only@localhost:5432/ai_kitchen
DATABASE_URL_MIGRATOR=                         # local dev may fall back to DATABASE_URL; production must configure a separate migration account
DATABASE_URL_TEST=postgresql://kitchen:change-me-dev-only@localhost:5432/ai_kitchen_test
# Optional secret-manager JSON; required only to store/read health notes.
# PROFILE_NOTES_KEYRING={"current":{"kid":"key-2026-01","key":"<base64url-32-byte-key>"},"previous":[]}
# Freshness sample confidence cutoff (B3B policy; inclusive).
FRESHNESS_MIN_CONFIDENCE=0.6
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=10000

# ───────── auth ─────────
# Access tokens are short-lived signed JWTs. Refresh tokens are opaque (sha256 stored on Session).
# JWT_REFRESH_SECRET is retained for env compatibility only (no longer used to sign refresh tokens).
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me
JWT_REFRESH_SECRET=change-me-too-change-me-too-change-me-too
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
EMAIL_VERIFY_TTL_HOURS=24
PASSWORD_RESET_TTL_MIN=30
INVITATION_TTL_DAYS=7
EMAIL_VERIFICATION_REQUIRED=false              # true outside dev

# ───────── outbox ─────────
ENABLE_OUTBOX_POLLER=true
RUN_BACKGROUND_JOBS=true                       # false on API replicas when `pnpm start:worker` (dist/worker.js) runs separately
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_BATCH_SIZE=10
OUTBOX_MAX_ATTEMPTS=8

# ───────── object storage (S3) ─────────
S3_REGION=us-east-1
S3_BUCKET=ai-kitchen-images
S3_ENDPOINT=http://localhost:8333              # server -> S3 (inside docker: http://s3:8333). Empty = real AWS S3
S3_PUBLIC_ENDPOINT=http://localhost:8333       # the host the BROWSER uses; presigned URLs are signed for it
S3_FORCE_PATH_STYLE=true                       # true for SeaweedFS, false for AWS S3
S3_ACCESS_KEY_ID=dev-access-key
S3_SECRET_ACCESS_KEY=dev-secret-key
S3_AUTO_CREATE_BUCKET=true                     # dev only
IMAGE_MAX_BYTES=10485760                       # 10 MB
IMAGE_PRESIGN_TTL_SEC=300
IMAGE_ALLOWED_MIME=image/jpeg,image/png,image/webp,image/heic

# ───────── email ─────────
MAIL_FROM="AI Kitchen <no-reply@ai-kitchen.local>"
SMTP_HOST=localhost                            # Mailpit in dev (inside docker: mailpit)
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_TEMPLATES_DIR=                            # empty = dist/platform/mail/templates

# ───────── push (Firebase Cloud Messaging HTTP v1; also supports iOS via Firebase APNs setup) ─────────
# Keep the private key in a local secret store; represent newlines as \n when using an env var.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
FCM_TOKEN_URI=https://oauth2.googleapis.com/token

# ───────── GraphQL / protection ─────────
GRAPHQL_DEPTH_LIMIT=7
GRAPHQL_COMPLEXITY_LIMIT=2000
GRAPHQL_INTROSPECTION=true                     # set false in production
METRICS_ENABLED=false
METRICS_TOKEN=                                  # required when METRICS_ENABLED=true; at least 32 random characters
THROTTLE_TTL_SEC=60
THROTTLE_LIMIT=120
THROTTLE_AUTH_LIMIT=10
THROTTLE_UPLOAD_LIMIT=20

# OpenAI-compatible multilingual-e5-small endpoint returning exactly 384 dimensions.
# The API layer adds the model's required `query:` and `passage:` prefixes.
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_TIMEOUT_MS=15000
EMBEDDING_POLL_INTERVAL_MS=1500
