generator client {
  provider        = "prisma-client"
  output          = "../src/generated"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model OutboxEvent {
  id             BigInt    @id @default(autoincrement())
  householdId    String?   @db.Uuid
  topic          String
  dedupeKey      String
  payload        Json
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  processedAt    DateTime? @db.Timestamptz(6)
  attempts       Int       @default(0)
  nextAttemptAt  DateTime  @default(now()) @db.Timestamptz(6)
  lastError      String?
  deadLetteredAt DateTime? @db.Timestamptz(6)

  @@unique([topic, dedupeKey], map: "OutboxEvent_topic_dedupeKey_open_uq", where: raw("((\"processedAt\" IS NULL) AND (\"deadLetteredAt\" IS NULL))"))
  @@index([nextAttemptAt, id], map: "OutboxEvent_ready_ix", where: raw("((\"processedAt\" IS NULL) AND (\"deadLetteredAt\" IS NULL))"))
}

model Country {
  id    String @id @db.Uuid
  code  String @unique @db.Char(2)
  name  String
  users User[]
}

model Language {
  id          String      @id @db.Uuid
  code        String      @unique
  name        String      @unique
  isRtl       Boolean
  foodAliases FoodAlias[]
  locales     Locale[]
  users       User[]
}

model Locale {
  id         String   @id @db.Uuid
  code       String   @unique
  name       String
  languageId String   @db.Uuid
  language   Language @relation(fields: [languageId], references: [id], onUpdate: NoAction)
  users      User[]
}

model Cuisine {
  id                   String                 @id @db.Uuid
  code                 String                 @unique
  name                 String
  Recipe               Recipe[]
  UserPreferredCuisine UserPreferredCuisine[]
}

model FoodCategory {
  id                      String                    @id @db.Uuid
  code                    String                    @unique
  name                    String
  DietaryRule             DietaryRule[]
  foods                   Food[]
  HealthConditionDietRule HealthConditionDietRule[]
  UserAllergyCategory     UserAllergyCategory[]
  UserDislikedCategory    UserDislikedCategory[]
}

model SearchDocument {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceType           SearchDocumentSource
  sourceId             String                 @db.Uuid
  householdId          String?                @db.Uuid
  userId               String?                @db.Uuid
  content              String
  isSearchable         Boolean                @default(true)
  embeddedContentHash  String?                @db.Char(64)
  embedding            Unsupported("vector(384)")?
  embeddingModel       String?
  embeddingStatus      SearchEmbeddingStatus  @default(PENDING)
  embeddingAttempts    Int                    @default(0) @db.SmallInt
  embeddingClaimedAt   DateTime?              @db.Timestamptz(6)
  embeddingUpdatedAt   DateTime?              @db.Timestamptz(6)
  lastEmbeddingError   String?
  createdAt            DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime               @default(now()) @db.Timestamptz(6)

  @@unique([sourceType, sourceId], map: "SearchDocument_source_uq")
  @@index([updatedAt], map: "SearchDocument_embedding_pending_ix", where: raw("\"embeddingStatus\" IN ('PENDING', 'FAILED')"))
  @@index([householdId, userId, sourceType], map: "SearchDocument_scope_type_ix")
  Household Household? @relation(fields: [householdId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "SearchDocument_household_fk")
  User User? @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "SearchDocument_user_fk")
}

model Currency {
  id             String          @id @db.Uuid
  code           String          @unique @db.Char(3)
  name           String
  symbol         String
  decimalPlaces  Int             @db.SmallInt
  isActive       Boolean         @default(true)
  productSources ProductSource[]
  PurchaseOrder  PurchaseOrder[]
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model Food {
  id                        String                      @id @db.Uuid
  categoryId                String                      @db.Uuid
  name                      String
  defaultUnit               Unit
  gramsPerPiece             Decimal?                    @db.Decimal(8, 2)
  densityGPerMl             Decimal?                    @db.Decimal(6, 3)
  archivedAt                DateTime?                   @db.Timestamptz(6)
  createdAt                 DateTime                    @default(now()) @db.Timestamptz(6)
  updatedAt                 DateTime                    @default(now()) @updatedAt @db.Timestamptz(6)
  AIFoodDepletionPrediction AIFoodDepletionPrediction[]
  DietaryRule               DietaryRule[]
  category                  FoodCategory                @relation(fields: [categoryId], references: [id], onUpdate: NoAction)
  aliases                   FoodAlias[]
  FoodEvent                 FoodEvent[]
  substitutionsOut          FoodSubstitution[]          @relation("FoodSubstitutionsOut")
  substitutionsIn           FoodSubstitution[]          @relation("FoodSubstitutionsIn")
  HealthConditionDietRule   HealthConditionDietRule[]
  InventoryItem             InventoryItem[]
  MealItem                  MealItem[]
  nutrition                 NutritionProfile?
  products                  Product[]
  PurchaseOrderItem         PurchaseOrderItem[]
  RecipeIngredient          RecipeIngredient[]
  ShoppingListItem          ShoppingListItem[]
  UserAllergy               UserAllergy[]
  UserDislikedFood          UserDislikedFood[]
  UserFoodPreference        UserFoodPreference[]

  @@index([categoryId], map: "Food_category_ix")
}

model FoodAlias {
  id              String   @id @db.Uuid
  foodId          String   @db.Uuid
  languageId      String   @db.Uuid
  alias           String
  aliasNormalized String?  @default(dbgenerated("normalize_food_alias(alias)"))
  isPrimary       Boolean  @default(false)
  food            Food     @relation(fields: [foodId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  language        Language @relation(fields: [languageId], references: [id], onUpdate: NoAction)

  @@unique([languageId, aliasNormalized], map: "FoodAlias_language_normalized_uq")
  @@unique([foodId, languageId], map: "FoodAlias_primary_language_uq", where: raw("\"isPrimary\""))
  @@index([foodId], map: "FoodAlias_food_ix")
}

model NutritionProfile {
  foodId          String   @id @db.Uuid
  caloriesPer100g Decimal  @db.Decimal(8, 2)
  proteinG        Decimal  @db.Decimal(8, 2)
  carbsG          Decimal  @db.Decimal(8, 2)
  fatG            Decimal  @db.Decimal(8, 2)
  fiberG          Decimal  @db.Decimal(8, 2)
  sugarG          Decimal  @db.Decimal(8, 2)
  sodiumMg        Decimal  @db.Decimal(8, 2)
  updatedAt       DateTime @default(now()) @db.Timestamptz(6)
  food            Food     @relation(fields: [foodId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model FoodSubstitution {
  id               String  @id @db.Uuid
  originalFoodId   String  @db.Uuid
  substituteFoodId String  @db.Uuid
  ratio            Decimal @db.Decimal(6, 3)
  notes            String?
  originalFood     Food    @relation("FoodSubstitutionsOut", fields: [originalFoodId], references: [id], onUpdate: NoAction)
  substituteFood   Food    @relation("FoodSubstitutionsIn", fields: [substituteFoodId], references: [id], onUpdate: NoAction)

  @@unique([originalFoodId, substituteFoodId], map: "FoodSubstitution_pair_uq")
}

model Product {
  id                String              @id @db.Uuid
  foodId            String              @db.Uuid
  brand             String?
  name              String
  barcode           String?             @unique(map: "Product_barcode_uq", where: raw("(barcode IS NOT NULL)"))
  packageSize       Decimal             @db.Decimal(12, 3)
  packageUnit       Unit
  archivedAt        DateTime?           @db.Timestamptz(6)
  InventoryItem     InventoryItem[]
  food              Food                @relation(fields: [foodId], references: [id], onUpdate: NoAction)
  sources           ProductSource[]
  PurchaseOrderItem PurchaseOrderItem[]
  ShoppingListItem  ShoppingListItem[]

  @@unique([id, foodId], map: "Product_id_food_uq")
  @@index([foodId], map: "Product_food_ix")
}

model ProductSource {
  id              String          @id @db.Uuid
  productId       String          @db.Uuid
  sourceName      String
  price           Decimal         @db.Decimal(14, 4)
  currencyId      String          @db.Uuid
  available       Boolean         @default(false)
  leadTimeDays    Int?
  sourceUrl       String?
  priceObservedAt DateTime        @db.Timestamptz(6)
  currency        Currency        @relation(fields: [currencyId], references: [id], onUpdate: NoAction)
  product         Product         @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  PurchaseOrder   PurchaseOrder[]

  @@unique([productId, sourceName], map: "ProductSource_pair_uq")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model User {
  id                                                              String                   @id @db.Uuid
  email                                                           String
  passwordHash                                                    String
  name                                                            String
  systemRole                                                      SystemRole               @default(USER)
  countryId                                                       String                   @db.Uuid
  localeId                                                        String                   @db.Uuid
  preferredLanguageId                                             String                   @db.Uuid
  timezone                                                        String
  emailVerifiedAt                                                 DateTime?                @db.Timestamptz(6)
  lastLoginAt                                                     DateTime?                @db.Timestamptz(6)
  createdAt                                                       DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt                                                       DateTime                 @default(now()) @updatedAt @db.Timestamptz(6)
  deletedAt                                                       DateTime?                @db.Timestamptz(6)
  AIPrediction                                                    AIPrediction[]
  SearchDocument                                                  SearchDocument[]
  FoodEvent                                                       FoodEvent[]
  memberships                                                     HouseholdMember[]
  Image                                                           Image[]
  PurchaseOrder                                                   PurchaseOrder[]
  sessions                                                        Session[]
  tokens                                                          Token[]
  country                                                         Country                  @relation(fields: [countryId], references: [id], onUpdate: NoAction)
  locale                                                          Locale                   @relation(fields: [localeId], references: [id], onUpdate: NoAction)
  preferredLanguage                                               Language                 @relation(fields: [preferredLanguageId], references: [id], onUpdate: NoAction)
  UserAllergy                                                     UserAllergy[]
  UserAllergyCategory                                             UserAllergyCategory[]
  UserDailyNutrition                                              UserDailyNutrition[]
  UserDietaryPreference                                           UserDietaryPreference[]
  UserDislikedCategory                                            UserDislikedCategory[]
  UserDislikedFood                                                UserDislikedFood[]
  UserFoodPreference                                              UserFoodPreference[]
  UserGoal                                                        UserGoal?
  UserHealthCondition                                             UserHealthCondition[]
  UserNutritionTrend                                              UserNutritionTrend[]
  UserPreference                                                  UserPreference?
  UserPreferredCuisine                                            UserPreferredCuisine[]
  UserProfile                                                     UserProfile?
  UserSafetyProfileEvent_UserSafetyProfileEvent_actorUserIdToUser UserSafetyProfileEvent[] @relation("UserSafetyProfileEvent_actorUserIdToUser")
  UserSafetyProfileEvent_UserSafetyProfileEvent_userIdToUser      UserSafetyProfileEvent[] @relation("UserSafetyProfileEvent_userIdToUser")
  UserWeightLog                                                   UserWeightLog[]
}

model Household {
  id                   String                 @id @db.Uuid
  name                 String
  timezone             String
  createdAt            DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime               @default(now()) @updatedAt @db.Timestamptz(6)
  deletedAt            DateTime?              @db.Timestamptz(6)
  AIPrediction         AIPrediction[]
  SearchDocument       SearchDocument[]
  FoodEvent            FoodEvent[]
  invitations          HouseholdInvitation[]
  members              HouseholdMember?
  Image                Image[]
  InventoryItem        InventoryItem[]
  InventoryTransaction InventoryTransaction[]
  Meal                 Meal[]
  MealPlan             MealPlan[]
  PurchaseOrder        PurchaseOrder[]
  Recipe               Recipe[]
  ShoppingList         ShoppingList[]
}

model HouseholdMember {
  id              String                @id @db.Uuid
  householdId     String                @unique(map: "HouseholdMember_one_active_owner_uq", where: raw("((role = 'OWNER'::\"HouseholdRole\") AND (\"leftAt\" IS NULL))")) @db.Uuid
  userId          String                @db.Uuid
  role            HouseholdRole
  joinedAt        DateTime              @default(now()) @db.Timestamptz(6)
  leftAt          DateTime?             @db.Timestamptz(6)
  AIPrediction    AIPrediction[]
  invitationsSent HouseholdInvitation[]
  household       Household             @relation(fields: [householdId], references: [id], onUpdate: NoAction)
  user            User                  @relation(fields: [userId], references: [id], onUpdate: NoAction)
  Meal            Meal[]

  @@unique([householdId, userId], map: "HouseholdMember_household_user_uq")
  @@index([userId], map: "HouseholdMember_user_active_ix", where: raw("(\"leftAt\" IS NULL)"))
}

model Token {
  id         String               @id @db.Uuid
  userId     String?              @db.Uuid
  purpose    TokenPurpose
  tokenHash  String               @unique
  expiresAt  DateTime             @db.Timestamptz(6)
  usedAt     DateTime?            @db.Timestamptz(6)
  createdAt  DateTime             @default(now()) @db.Timestamptz(6)
  invitation HouseholdInvitation?
  user       User?                @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([expiresAt], map: "Token_expiresAt_ix")
  @@index([userId, purpose], map: "Token_user_purpose_open_ix", where: raw("(\"usedAt\" IS NULL)"))
}

model HouseholdInvitation {
  id              String          @id @db.Uuid
  householdId     String          @db.Uuid
  invitedByUserId String          @db.Uuid
  email           String
  tokenId         String          @unique @db.Uuid
  role            HouseholdRole
  acceptedAt      DateTime?       @db.Timestamptz(6)
  revokedAt       DateTime?       @db.Timestamptz(6)
  createdAt       DateTime        @default(now()) @db.Timestamptz(6)
  household       Household       @relation(fields: [householdId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  inviter         HouseholdMember @relation(fields: [householdId, invitedByUserId], references: [householdId, userId], onUpdate: NoAction, map: "HouseholdInvitation_inviter_fk")
  token           Token           @relation(fields: [tokenId], references: [id], onUpdate: NoAction)

  @@unique([householdId, email], map: "HouseholdInvitation_open_uq", where: raw("((\"acceptedAt\" IS NULL) AND (\"revokedAt\" IS NULL))"))
  @@index([householdId], map: "HouseholdInvitation_household_ix")
}

model Session {
  id               String    @id @db.Uuid
  userId           String    @db.Uuid
  familyId         String    @db.Uuid
  refreshTokenHash String    @unique(map: "Session_refreshTokenHash_uq")
  expiresAt        DateTime  @db.Timestamptz(6)
  rotatedAt        DateTime? @db.Timestamptz(6)
  revokedAt        DateTime? @db.Timestamptz(6)
  lastUsedAt       DateTime? @db.Timestamptz(6)
  userAgent        String?
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([expiresAt], map: "Session_expiresAt_ix")
  @@index([familyId], map: "Session_familyId_ix")
  @@index([userId], map: "Session_user_active_ix", where: raw("(\"revokedAt\" IS NULL)"))
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model FoodEvent {
  id                   String                 @id @db.Uuid
  householdId          String                 @db.Uuid
  actorUserId          String?                @db.Uuid
  foodId               String                 @db.Uuid
  inventoryItemId      String?                @db.Uuid
  type                 FoodEventType
  origin               ItemOrigin
  source               EventSource            @default(USER)
  quantity             Decimal                @db.Decimal(12, 3)
  unit                 Unit
  occurredAt           DateTime               @default(now()) @db.Timestamptz(6)
  idempotencyKey       String
  createdAt            DateTime               @default(now()) @db.Timestamptz(6)
  purchaseOrderItemId  String?                @db.Uuid
  User                 User?                  @relation(fields: [actorUserId], references: [id], onUpdate: NoAction)
  Food                 Food                   @relation(fields: [foodId], references: [id], onUpdate: NoAction)
  Household            Household              @relation(fields: [householdId], references: [id], onUpdate: NoAction)
  InventoryItem        InventoryItem?         @relation(fields: [inventoryItemId, householdId], references: [id, householdId], onUpdate: NoAction, map: "FoodEvent_item_household_fk")
  PurchaseOrderItem    PurchaseOrderItem?     @relation("FoodEvent_PurchaseOrderItem_purchaseOrderItemId_householdIdToPurchaseOrderItem", fields: [purchaseOrderItemId, householdId], references: [id, householdId], onUpdate: NoAction, map: "FoodEvent_purchase_item_household_fk")
  InventoryTransaction InventoryTransaction[]

  @@unique([householdId, idempotencyKey], map: "FoodEvent_household_key_uq")
  @@unique([id, householdId, origin], map: "FoodEvent_id_household_origin_uq")
  @@index([householdId, occurredAt(sort: Desc), id(sort: Desc)], map: "FoodEvent_household_occurred_ix")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model InventoryItem {
  id                   String                 @id @db.Uuid
  householdId          String                 @db.Uuid
  foodId               String                 @db.Uuid
  productId            String?                @db.Uuid
  quantity             Decimal                @default(0) @db.Decimal(12, 3)
  unit                 Unit
  storageLocation      StorageLocation        @default(PANTRY)
  purchaseDate         DateTime?              @db.Date
  openedDate           DateTime?              @db.Date
  estimatedExpiryAt    DateTime?              @db.Timestamptz(6)
  freshnessScore       Decimal?               @db.Decimal(4, 3)
  version              Int                    @default(1)
  archivedAt           DateTime?              @db.Timestamptz(6)
  createdAt            DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime               @default(now()) @db.Timestamptz(6)
  FoodEvent            FoodEvent[]
  FreshnessPrediction  FreshnessPrediction[]
  Food                 Food                   @relation(fields: [foodId], references: [id], onUpdate: NoAction)
  Household            Household              @relation(fields: [householdId], references: [id], onUpdate: NoAction)
  Product              Product?               @relation(fields: [productId, foodId], references: [id, foodId], onUpdate: NoAction, map: "InventoryItem_product_food_fk")
  InventoryTransaction InventoryTransaction[]

  @@unique([id, householdId], map: "InventoryItem_id_household_uq")
  @@index([householdId, estimatedExpiryAt], map: "InventoryItem_household_expiry_live_ix", where: raw("(\"archivedAt\" IS NULL)"))
  @@index([estimatedExpiryAt, id], map: "InventoryItem_expiry_candidate_ix", where: raw("((\"archivedAt\" IS NULL) AND (\"quantity\" > 0))"))
  @@index([householdId, foodId], map: "InventoryItem_household_food_live_ix", where: raw("(\"archivedAt\" IS NULL)"))
  @@index([updatedAt], map: "InventoryItem_freshness_due_ix", where: raw("((\"freshnessScore\" IS NOT NULL) AND (\"archivedAt\" IS NULL))"))
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
