  type               RecommendationType
  status             RecommendationStatus @default(DRAFT)
  safetyStatus       SafetyStatus         @default(PENDING)
  summary            String?              @db.Text
  modelVersion       String               @db.Text
  inputHash          String               @db.Text
  sourcePredictionId String?              @db.Uuid
  generatedAt        DateTime             @default(now()) @db.Timestamptz(6)
  expiresAt          DateTime             @db.Timestamptz(6)
  statusChangedAt    DateTime             @default(now()) @db.Timestamptz(6)
  feedbackFoldedAt   DateTime?            @db.Timestamptz(6)

  @@unique([id, householdId], map: "AIRecommendation_id_household_uq")
  @@unique([id, type], map: "AIRecommendation_id_type_uq")
  @@unique([id, type, householdId], map: "AIRecommendation_id_type_household_uq")
  @@index([expiresAt], map: "AIRecommendation_expiry_ix")
  @@map("AIRecommendation")
}

